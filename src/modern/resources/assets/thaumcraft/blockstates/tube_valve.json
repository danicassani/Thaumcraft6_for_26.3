{
  "multipart": [
    {
      "apply": {
        "model": "thaumcraft:block/tube_core"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 180
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "open": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_open"
      }
    },
    {
      "when": {
        "facing": "north",
        "open": "false"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_closed"
      }
    },
    {
      "when": {
        "facing": "east",
        "open": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_open",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "open": "false"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_closed",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "open": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_open",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "open": "false"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_closed",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "open": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_open",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "open": "false"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_closed",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "up",
        "open": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_open",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "up",
        "open": "false"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_closed",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "down",
        "open": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_open",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "down",
        "open": "false"
      },
      "apply": {
        "model": "thaumcraft:block/tube_valve_closed",
        "x": 90
      }
    }
  ]
}
